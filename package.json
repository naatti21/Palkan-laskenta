{
  "name": "palkka-pwa-qa",
  "private": true,
  "version": "0.4.1",
  "scripts": {
    "prepare:pdfjs": "node scripts/prepare-pdfjs.mjs",
    "test": "node --test tests/*.test.mjs && npm run test:e2e",
    "test:logic": "node --test tests/*.test.mjs",
    "test:e2e": "npm run prepare:pdfjs && playwright test",
    "test:smoke": "npm run prepare:pdfjs && playwright test --grep @smoke"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0"
  },
  "type": "module"
}
